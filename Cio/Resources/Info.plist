<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSEnvironment</key>
	<dict>
		<!-- Required by Chromium on macOS (PartitionAlloc / nano zone). -->
		<key>MallocNanoZone</key>
		<string>0</string>
	</dict>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array><dict>
		<key>CFBundleURLName</key><string>Web URLs</string>
		<key>CFBundleTypeRole</key><string>Viewer</string>
		<key>CFBundleURLSchemes</key><array><string>http</string><string>https</string></array>
	</dict></array>
	<key>NSCameraUsageDescription</key>
	<string>Cio lets websites use your camera only after you allow access.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cio lets websites use your microphone only after you allow access.</string>
	<key>NSLocationUsageDescription</key>
	<string>Cio lets websites use your location only after you allow access.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cio lets websites use your location only after you allow access.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cio uses Bluetooth to let you sign in to websites with a passkey from a nearby phone or security device.</string>
	<key>NSPrincipalClass</key>
	<string>BrowserCrApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
